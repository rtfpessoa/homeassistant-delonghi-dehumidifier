{
  "config": {
    "step": {
      "user": {
        "data": {
          "language": "[%key:common::config_flow::data::language%]",
          "email": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "reauth_confirm": {
        "description": "Enter the password for {email} to reconnect your DeLonghi account.",
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reauth_successful": "Reauthentication was successful",
      "reauth_settings_changed": "The integration settings changed. Please start reauthentication again.",
      "reauth_cancelled": "Reauthentication was cancelled."
    }
  }
}
